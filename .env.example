DATABASE_URL="postgresql://user:password@host/provas_dev?sslmode=require"
DATABASE_URL_TEST="postgresql://user:password@host/provas_test?sslmode=require"
PORT=3000
NODE_ENV=development

UPLOADCARE_PUBLIC_KEY=your_public_key_here
UPLOADCARE_SECRET_KEY=your_secret_key_here

JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long-for-security
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=*
