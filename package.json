{
  "name": "gerador-provas-api",
  "version": "1.0.0",
  "description": "API Gerador de Provas — template do curso Back-end 2026",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "find src -name '*.js' | xargs node --check",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:pratica": "vitest run --exclude tests/swagger.test.js && vitest run tests/swagger.test.js -t Prática",
    "test:atividade": "vitest run tests/swagger.test.js -t Atividade"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "prisma",
    "education"
  ],
  "author": "Arthur Porto",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@uploadcare/upload-client": "^6.18.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
